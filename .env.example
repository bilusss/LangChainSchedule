# ===========================================
# PRZYKŁADOWY PLIK KONFIGURACYJNY
# ===========================================
# Skopiuj ten plik jako .env i uzupełnij własnymi kluczami:
#   cp .env.example .env
#
# NIGDY nie commituj pliku .env z prawdziwymi kluczami!
# ===========================================

# Google Gemini API Key (dla LLM)
# Pobierz z: https://aistudio.google.com/apikey
GOOGLE_API_KEY_LLM=your_google_gemini_api_key_here

# Google Cloud API Key (dla Calendar API - opcjonalne, preferowane OAuth2)
# Pobierz z: https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY_CLOUD=your_google_cloud_api_key_here

# GROQ API Key (dla modelu qwen/qwen3-32b)
# Pobierz z: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# ===========================================
# OPCJONALNE - dla innych providerów LLM
# ===========================================

# OpenAI API Key (jeśli używasz GPT-4)
# OPENAI_API_KEY=sk-your_openai_api_key_here

# Anthropic API Key (jeśli używasz Claude)
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
