{
  "_comment": "PRZYKŁADOWY PLIK - Skopiuj jako credentials.json i uzupełnij własnymi danymi z Google Cloud Console",
  "_instructions": [
    "1. Wejdź na https://console.cloud.google.com/apis/credentials",
    "2. Utwórz OAuth 2.0 Client ID (typ: Desktop application)",
    "3. Pobierz JSON i zapisz jako credentials.json",
    "4. NIGDY nie commituj credentials.json z prawdziwymi danymi!"
  ],
  "installed": {
    "client_id": "YOUR_CLIENT_ID.apps.googleusercontent.com",
    "project_id": "your-project-id",
    "auth_uri": "https://accounts.google.com/o/oauth2/auth",
    "token_uri": "https://oauth2.googleapis.com/token",
    "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
    "client_secret": "YOUR_CLIENT_SECRET",
    "redirect_uris": [
      "http://localhost"
    ]
  }
}
