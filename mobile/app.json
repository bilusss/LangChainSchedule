{
  "expo": {
    "name": "Calendar AI",
    "slug": "calendar-ai-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.calendarai.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Ta aplikacja potrzebuje dostępu do mikrofonu do rozpoznawania mowy."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.calendarai.mobile",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "your-project-id"
      }
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "Ta aplikacja potrzebuje dostępu do mikrofonu do nagrywania poleceń głosowych."
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
